[Unit]
Description=vLLM serving GLM-4.7-Flash
After=network-online.target
Wants=network-online.target
# Single GPU, and every unit here publishes 8000. Conflicts makes systemd stop
# the other model before starting this one instead of failing on a port clash or
# a VRAM allocation error. llama-swap is listed too: it binds the same port and
# manages its own containers, so the two paths are mutually exclusive.
Conflicts=qwen3-coder.service nemotron-nano.service gemma4-26b.service llama-swap.service

[Container]
# Stable release. vLLM 0.28.0 bumped its transformers requirement to 5.15.0,
# which is what made the model's glm4_moe_lite architecture loadable without a
# nightly build. The old vllm/vllm-openai:glm5 workaround image is obsolete.
Image=docker.io/vllm/vllm-openai:v0.29.0
ContainerName=glm-flash

PublishPort=127.0.0.1:8000:8000

# Rootless podman maps container root to your host UID, so the downloaded
# weights land here owned by you.
Volume=%h/.cache/huggingface:/root/.cache/huggingface:z
# torch.compile / CUDA graph artifacts. Persisting these across container
# recreation is what makes restarts and model swaps faster than first boot.
# Invalidated when engine flags such as --max-model-len change.
Volume=%h/.cache/vllm:/root/.cache/vllm:z

# CDI device, generated with:
#   sudo nvidia-ctk cdi generate --output=/etc/cdi/nvidia.yaml
AddDevice=nvidia.com/gpu=all

# Gentoo's udev rules make /dev/nvidia* mode 0660 root:video. Rootless podman
# drops supplementary groups by default, so without this the container user is
# not in `video` and NVML fails with "Insufficient Permissions". Requires crun.
GroupAdd=keep-groups

# vLLM needs a large shared-memory segment.
PodmanArgs=--ipc=host

# curl is not guaranteed in the vLLM image; python3 always is.
HealthCmd=python3 -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8000/health').status == 200 else 1)"
HealthInterval=30s
HealthTimeout=5s
HealthRetries=20
HealthStartPeriod=10m

# Preserved Thinking is set server-side via --default-chat-template-kwargs so
# opencode keeps sending plain OpenAI requests. clear_thinking:false is what
# retains reasoning blocks across turns.
#
# clear_thinking:false retains previous turns' reasoning in the transcript. This
# is the default on purpose, and both settings were measured.
#
# clear_thinking:true drops prior reasoning, and was expected to slow context
# growth. It did not: compaction stayed at roughly the same cadence (every 1-3
# steps at 45056 client context). So its one benefit does not materialise here,
# because tool output volume is what fills the window, not reasoning tokens --
# a single 800-line file read is 10-15k tokens. Its cost is real though: the
# model stops seeing its own prior chain of thought, and retained reasoning is
# where it records which approaches it already tried and rejected, which is the
# first thing compaction destroys.
#
# That negative result is also why the sibling units are chosen for KV cache
# efficiency rather than reasoning behaviour.
#
# Flip to true only if you catch the model anchoring on a stale plan from an
# earlier turn. enable_thinking is the separate switch for reasoning at all, and
# is unaffected: the model still thinks on every turn and tool call either way.
#
# Sampling follows Z.ai's published eval settings for SWE-bench / Terminal
# Bench. repetition_penalty 1.0 disables it; Z.ai and Unsloth both advise
# against any penalty for this model.
Exec=--model cyankiwi/GLM-4.7-Flash-AWQ-4bit \
     --served-model-name glm-4.7-flash \
     --tensor-parallel-size 1 \
     --max-model-len 65536 \
     --gpu-memory-utilization 0.90 \
     --max-num-seqs 2 \
     --tool-call-parser glm47 \
     --reasoning-parser glm45 \
     --enable-auto-tool-choice \
     --default-chat-template-kwargs '{"enable_thinking":true,"clear_thinking":false}' \
     --override-generation-config '{"temperature":0.7,"top_p":1.0,"repetition_penalty":1.0}'

[Service]
Restart=always
# First boot downloads ~17GB of weights and captures CUDA graphs.
TimeoutStartSec=1800

# No [Install] section: the service is manual-start only. Uncomment to have it
# come up automatically at boot (requires `loginctl enable-linger $USER`).
# [Install]
# WantedBy=default.target
