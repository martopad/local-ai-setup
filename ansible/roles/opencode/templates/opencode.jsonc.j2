{% raw %}
// This file is automatically generated by Ansible from the templates in
// ansible/roles/opencode/templates/opencode.jsonc.j2.
{% endraw %}
{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": false
  },
  "plugins": ["billion-context"],
  "pluginConfig": {
    "billion-context": {
      "models": {
{% for model in target_models if model.opencode_enabled %}
        "vllm/{{ model.id }}": {
          "name": "{{ model.name }}",
          "nudgeThreshold": {% set context = ((total_vram_gb * gpu_utilization - model.weights_gb) / model.kv_cache_per_token_gb - model.limit_output - model.limit_context_slack) | int %}{{ (context * 8) // 10 }},
          "nudgeFloor": {{ (context * 1) // 10 if (context * 1) // 10 >= 1000 else 1000 }},
          "maxCompressible": {{ (context * 15) // 100 }}
        }{% if not loop.last and target_models[loop.index + 1 if loop.index + 1 < target_models|length else 0].opencode_enabled %},
{% endif %}
{% endfor %}
      }
    }
  },
  "providers": {
    "vllm": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "local (llama-swap / vLLM)",
      "settings": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "unused"
      },
      "models": {
{% for model in target_models if model.opencode_enabled %}
        "{{ model.id }}": {
          "name": "{{ model.name }}",
          "limit": {
            "context": {{ ((total_vram_gb * gpu_utilization - model.weights_gb) / model.kv_cache_per_token_gb - model.limit_output - model.limit_context_slack) | int }},
            "output": {{ model.limit_output | int }}
          }
        }{% if not loop.last and target_models[loop.index + 1 if loop.index + 1 < target_models|length else 0].opencode_enabled %},
{% endif %}
{% endfor %}
      }
    }
  },
  "model": "vllm/{{ target_models[0].id }}"
}
