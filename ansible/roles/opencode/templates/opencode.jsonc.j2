{% raw %}
// This file is automatically generated by Ansible from the templates in
// ansible/roles/opencode/templates/opencode.jsonc.j2.
{% endraw %}
{# Local provider models: the effective model list (host-specific
   llama_swap_models wins, shared target_models is the default), filtered
   to opencode-enabled. Byte-identical to the old form on hosts without
   llama_swap_models. #}
{% set opencode_models = (llama_swap_models | default(target_models)) | selectattr('opencode_enabled', 'equalto', true) | list %}
{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": false,
    "prune": false
  },
  "instructions": [
{% for path in opencode_instructions %}
    "{{ path }}"{{ "," if not loop.last }}
{% endfor %}
  ],
  "plugins": [
{% for plugin in opencode_plugins %}
    "{{ plugin }}"{{ "," if not loop.last }}
{% endfor %}
  ],
  "providers": {
    "vllm": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "local (llama-swap / vLLM)",
      "settings": {
        "baseURL": "{{ vllm_base_url }}",
        "apiKey": "unused"
      },
      "models": {
{% for model in opencode_models %}
        "{{ model.id }}": {
          "name": "{{ model.opencode_name | default(model.name) }}",
          "limit": {
            "context": {{ model.max_model_len }},
            "output": {{ model.limit_output }}
          }{{ "," if model.opencode_capabilities is defined or model.opencode_variants is defined }}
{% if model.opencode_capabilities is defined %}
          "capabilities": {{ model.opencode_capabilities | to_json }}{{ "," if model.opencode_variants is defined }}
{% endif %}
{% if model.opencode_variants is defined %}
          "variants": [
{% for variant in model.opencode_variants %}
            {
              "id": "{{ variant.id }}",
              "body": {{ variant.body | to_json }}
            }{{ "," if not loop.last }}
{% endfor %}
          ]
{% endif %}
        }{{ "," if not loop.last }}
{% endfor %}
      }
    }{{ "," if (vllm_endpoints | default([])) | length }}
{# Remote providers (one per entry in vllm_endpoints; the local "vllm"
   provider above is rendered from the model list, not from here). Each
   entry carries its own model catalog -- windows are that endpoint's
   business. #}
{% for ep in vllm_endpoints | default([]) %}
    "{{ ep.provider }}": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "{{ ep.name | default(ep.provider) }}",
{# Unknown settings keys are providerOptions: the openai-compatible provider
   merges them into every request body for this endpoint (e.g. the GLM pool's
   preserve_thinking, see group_vars vllm_endpoints). Rendered as one
   expression so the block stays byte-stable for endpoints without settings. #}
      "settings": {{ ({'baseURL': ep.base_url, 'apiKey': 'unused'} | combine(ep.settings | default({}))) | to_json }},
      "models": {
{% for mid, spec in ep.models.items() %}
        "{{ mid }}": {
          "name": "{{ spec.name | default(mid) }}",
          "limit": {
            "context": {{ spec.context }},
            "output": {{ spec.output }}
          }{{ "," if spec.capabilities is defined or spec.variants is defined }}
{% if spec.capabilities is defined %}
          "capabilities": {{ spec.capabilities | to_json }}{{ "," if spec.variants is defined }}
{% endif %}
{% if spec.variants is defined %}
          "variants": [
{% for variant in spec.variants %}
            {
              "id": "{{ variant.id }}",
              "body": {{ variant.body | to_json }}
            }{{ "," if not loop.last }}
{% endfor %}
          ]
{% endif %}
        }{{ "," if not loop.last }}
{% endfor %}
      }
    }{{ "," if not loop.last }}
{% endfor %}
  },
  "model": "{{ opencode_default_model }}"
}
