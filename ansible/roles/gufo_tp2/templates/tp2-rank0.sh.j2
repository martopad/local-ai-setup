#!/bin/bash
# Detached rank0 launcher (debug / manual path, no llama-swap). Usage: tp2-rank0.sh
set -euo pipefail
RDEV=$(ibv_devices | awk "/usb4_rdma/{print \$2, \$1}" | sort | head -n1 | awk "{print \$2}")
echo "rank0 rail=$RDEV"
podman rm -f gufo-tp2-rank0 2>/dev/null || true
podman run -d --name gufo-tp2-rank0 \
  --net=host \
  --device /dev/kfd \
  --device /dev/dri/renderD128 \
  --device /dev/infiniband/uverbs0 \
  --device /dev/infiniband/uverbs1 \
  --device /dev/infiniband/rdma_cm \
  -v {{ gufo_tp2_model_dir }}:/models \
  {{ gufo_tp2_image }} bash -c "cd /build/gufo && exec ./build/release/gufo serve --host 0.0.0.0 --port {{ gufo_tp2_http_port }} --max-request-bytes 268435456 llm --served-model-name '{{ gufo_tp2_served_model_name }}' --model {{ gufo_tp2_model_file }} --speculative mtp --mtp-model {{ gufo_tp2_mtp_model }} --mmproj {{ gufo_tp2_mmproj }} --tp-world-size 2 --tp-rank 0 --tp-bootstrap-port {{ gufo_tp2_bootstrap_port }} --tp-control-port {{ gufo_tp2_control_port }} --tp-control-token {{ gufo_tp2_control_token }} --tp-rdma-device '$RDEV' --sessions {{ gufo_tp2_sessions }} --context {{ gufo_tp2_context }} --enable-yarn"
echo "rank0 launched"
