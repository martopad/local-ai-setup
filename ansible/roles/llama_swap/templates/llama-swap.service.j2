# This file is automatically generated by Ansible from the templates in
# ansible/roles/llama_swap/templates/llama-swap.service.j2.
#
# Install to {{ ansible_user_dir }}/.config/systemd/user/llama-swap.service
#
# Deliberately a plain systemd unit. llama-swap spawns podman containers itself,
# and running it *inside* a container would mean bind-mounting the rootless podman
# socket so it could start siblings -- more moving parts, and a second thing that
# can break the way GPU passthrough did. It is a single static Go binary, so
# running it on the host is simpler.
#
# Installed from a Portage overlay, which puts the binary in /usr/bin. Confirm
# with `command -v llama-swap` and correct ExecStart below if it differs.
#
#   mkdir -p {{ ansible_user_dir }}/.config/llama-swap {{ ansible_user_dir }}/.config/systemd/user
#   cp config.yaml {{ ansible_user_dir }}/.config/llama-swap/config.yaml
#   cp llama-swap.service {{ ansible_user_dir }}/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user start llama-swap
#
# This is deliberately a **user** unit, not the system unit an ebuild may ship.
# The spawned vLLM containers have to run as your user: rootless podman, the HF
# cache under your home, and `video` group membership for /dev/nvidia*. A system
# service running as root or a dedicated llama-swap user would not have those.
# If the ebuild installed a system unit, leave it disabled.
#
[Unit]
Description=llama-swap model router in front of vLLM
Documentation=https://github.com/mostlygeek/llama-swap
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Listens on the port opencode already uses, so no client-side change is needed.
# Models get ports from startPort in config.yaml instead.
# 0.0.0.0: reachable from other LAN machines (the box's LAN addrs are
# .186/.183). Loopback-only would break remote opencode clients; note
# this also exposes the unauthenticated model endpoint on the LAN.
ExecStart={{ llama_swap_bin | default('/usr/bin/llama-swap') }} --config {{ ansible_user_dir }}/.config/llama-swap/config.yaml --listen 0.0.0.0:8000

# Give llama-swap time to run cmdStop (podman stop -t 30) and let vLLM
# shut down cleanly. Two loaded models stopped in series need ~2x30s,
# and 60s was not enough: the 2026-11-08 restart had systemd SIGKILL
# llama-swap mid-cleanup and the containers (not in the unit's cgroup)
# were left orphaned, pinning VRAM and their podman names until killed
# by hand. 120s covers two serial stops with margin.
TimeoutStopSec=120
KillMode=mixed

# Safety net. A vLLM container that outlives llama-swap keeps ~15-17GB of VRAM
# pinned and the next start will fail (the podman name is still held). The
# list is derived from target_models so it always covers every model that
# can exist -- a hard-coded list went stale when five models were added in
# Nov 2026 and orphaned two containers that had to be killed by hand.
ExecStopPost=/bin/sh -c 'podman stop -t 30 --ignore {{ llama_swap_models | default(target_models) | map(attribute='container_name') | join(' ') }} || true'

Restart=on-failure
RestartSec=5

# No [Install] section: manual-start only. Enable it with
# `systemctl --user enable llama-swap` plus `loginctl enable-linger $USER`
# if you ever want it at boot.
