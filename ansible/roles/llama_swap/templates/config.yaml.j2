# llama-swap: on-demand model switching in front of vLLM.
#
# llama-swap runs as a native binary on the host and spawns each model as a
# throwaway podman container. It owns the container lifecycle via cmd/cmdStop,
# which is why the per-model Quadlet units are no longer started directly --
# see ../README.md. The Quadlet units are kept as a single-model debug path.
#
# Listens on 8000, the port opencode already points at, so switching between
# this and a bare Quadlet unit needs no opencode change. Only one of the two
# can run at a time; the port collision enforces that.
#
# Each model also sets `ttl: 1800`, which unloads it after 30 minutes idle so the
# card is free when you walk away. `POST /api/models/unload` does it immediately.
#
# This file is automatically generated by Ansible from the templates in
# ansible/roles/llama_swap/templates/config.yaml.j2.
#
# Podman flags only, up to but NOT including the image. Everything after an
# image name is passed to the container's entrypoint instead of to podman, so
# --name and the image itself have to be spelled out per model below.
#
# Paths are absolute: llama-swap has no systemd specifiers, does not expand
# $HOME, and does not expand macros recursively inside other macros. Change
# /home/martin if your user differs.
#
# Mirrors the working glm-flash.container:
#   --device nvidia.com/gpu=all  CDI device, from `nvidia-ctk cdi generate`
#   --group-add keep-groups      Gentoo udev makes /dev/nvidia* 0660 root:video
#                                and rootless podman drops supplementary
#                                groups, so without this NVML reports
#                                "Insufficient Permissions". Requires crun.
#   --ipc=host                   vLLM needs a large shared-memory segment.
#   --rm --init                  No leftover containers; --init gives a real
#                                PID 1 so SIGTERM from cmdStop is honoured.
#
# Model-specific comments are stored in ansible/group_vars/all.yaml.
#
healthCheckTimeout: 1800
logLevel: debug
startPort: 5800

models:
{# Effective model list: host-specific llama_swap_models (its own GPU's args,
   images, windows) win; shared target_models is the default. #}
{% for model in llama_swap_models | default(target_models) if model.llama_swap_enabled | default(true) %}
  "{{ model.id }}":
    name: "{{ model.name }}"
{# Script models (cmd_override): the cmd is a raw host command, not a
   podman invocation — e.g. the two-box Gufo-TP2 launcher, which
   shells out to a wrapper that starts the remote rank over SSH and
   runs the local rank in the foreground. The podman block below is
   skipped entirely; vLLM args never render for these. Podman-model
   entries render byte-identically to before. #}
{% if model.cmd_override is defined %}
    cmd: {{ model.cmd_override }}
{% else %}
    cmd: >-
      podman run --rm --init
{% for flag in model.podman_flags | default(gpu_podman_flags) %}
      {{ flag }}
{% endfor %}
      --name {{ model.container_name }}
      {{ model.vllm_image }}
{% if model.positional_model is defined %}
      {{ model.positional_model }}
{% endif %}
{# vLLM-only args are gated on the per-model engine marker: non-vLLM
   entries (gufo, llama.cpp) set `vllm: false` and launch their own
   OpenAI-compatible server via positional_model instead. vLLM models
   render byte-identically to before. #}
{% if model.vllm | default(true) %}
      --max-model-len {{ model.max_model_len }}
{% endif %}
{% for arg in model.vllm_args %}
      {{ arg }}
{% endfor %}
{% if model.vllm | default(true) %}
{# Deployment-wide (vLLM only): expose prompt_tokens_details
   (cached_tokens etc.) in the OpenAI usage response so clients can
   measure prefix-cache hits. vLLM's default is off; prefix caching
   itself is already enabled. #}
      --enable-prompt-tokens-details
{% endif %}
{% endif %}
    cmdStop: "{{ model.cmdStop }}"
    proxy: "{{ model.proxy }}"
    checkEndpoint: {{ model.checkEndpoint }}
    ttl: {{ model.ttl }}
{% endfor %}
{% if llama_swap_routing is defined %}
{# Fail fast if a routing group references a model that is not enabled:
   llama-swap refuses to start ("no model config for ...") and crash-loops. #}
{# jinja2 has no list comprehensions and selectattr can't resolve dict
   keys — build the list with the append idiom. Active = enabled or
   keyless (matches the models loop above). #}
{% set active_ids = [] %}
{% for m in llama_swap_models | default(target_models) %}
{% if m.llama_swap_enabled | default(true) %}
{% set _ = active_ids.append(m.id) %}
{% endif %}
{% endfor %}
{% for group in llama_swap_routing %}
{% set missing = group.members | reject('in', active_ids) | list %}
{% if missing | length > 0 %}
{{ raise('routing group "' ~ group.name ~ '" references models without an enabled config entry: ' ~ missing | join(', ')) }}
{% endif %}
{% endfor %}
routing:
  router:
    use: group
    settings:
      groups:

{% for group in llama_swap_routing %}
        # {{ group.comment }}
        {{ group.name }}:
          swap: {{ 'true' if group.swap else 'false' }}
          exclusive: {{ 'true' if group.exclusive else 'false' }}
{% if group.persistent is defined %}
          persistent: {{ 'true' if group.persistent else 'false' }}
{% endif %}
          members:
{# Rendered as-is: the guard above has already raised if any member
   lacks an enabled config entry. #}
{% for member in group.members %}
            - "{{ member }}"
{% endfor %}
{% if not loop.last %}

{% endif %}
{% endfor %}
{% endif %}
