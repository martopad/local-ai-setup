# llama-swap: on-demand model switching in front of vLLM.
#
# llama-swap runs as a native binary on the host and spawns each model as a
# throwaway podman container. It owns the container lifecycle via cmd/cmdStop.
#
# Listens on 8000, the port opencode already points at, so switching between
# models needs no opencode change. Only one model can run at a time; the port
# collision enforces that.
#
# vLLM cold start is 60-120s with a warm torch.compile cache and much longer on
# first run (weight download + graph capture). llama-swap's default of 120s is
# far too low and produces spurious failures mid-swap.
healthCheckTimeout: 1800

logLevel: info

# Ports handed to ${PORT}. Kept clear of 8000 (llama-swap itself) and 11434.
startPort: 5800

# Each model also sets `ttl: 1800`, which unloads it after 30 minutes idle so the
# card is free when you walk away. `POST /api/models/unload` does it immediately.

macros:
  # Podman flags only, up to but NOT including the image. Everything after an
  # image name is passed to the container's entrypoint instead of to podman, so
  # --name and the image itself have to be spelled out per model below.
  #
  # Paths are absolute: llama-swap has no systemd specifiers, does not expand
  # $HOME, and does not expand macros recursively inside other macros. Change
  # /home/martin if your user differs.
  #
  # Mirrors the working glm-flash.container:
  #   --device nvidia.com/gpu=all  CDI device, from `nvidia-ctk cdi generate`
  #   --group-add keep-groups      Gentitu udev makes /dev/nvidia* 0660 root:video
  #                                and rootless podman drops supplementary
  #                                groups, so without this NVML reports
  #                                "Insufficient Permissions". Requires crun.
  #   --ipc=host                   vLLM needs a large shared-memory segment.
  #   --rm --init                  No leftover containers; --init gives a real
  #                                PID 1 so SIGTERM from cmdStop is honoured.
  podman-flags: >-
    podman run --rm --init
    --device nvidia.com/gpu=all
    --group-add keep-groups
    --ipc=host
    -p 127.0.0.1:${PORT}:8000
    -v {{ ansible_user_dir }}/.cache/huggingface:/root/.cache/huggingface:z
    -v {{ ansible_user_dir }}/.cache/vllm:/root/.cache/vllm:z
    -v {{ ansible_user_dir }}/.cache/vllm-parsers:/parsers:z

models:
{% for model in target_models %}
  "{{ model.id }}":
    name: "{{ model.name }}"
    cmd: >-
      ${podman-flags}
        {{ model.vllm_image }}
        --max-model-len {{ ((total_vram_gb * gpu_utilization - model.weights_gb) / model.kv_cache_per_token_gb) | int }}
        {{ model.cmd_args | join(' ') }}
    cmdStop: "{{ model.cmdStop }}"
    proxy: "{{ model.proxy }}"
    checkEndpoint: "{{ model.checkEndpoint }}"
    ttl: {{ model.ttl }}
{% endfor %}
