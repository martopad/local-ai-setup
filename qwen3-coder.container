[Unit]
Description=vLLM serving Qwen3-Coder-30B-A3B (non-thinking)
After=network-online.target
Wants=network-online.target
# Single GPU, and every unit here publishes 8000. Conflicts makes systemd stop
# the other model before starting this one instead of failing on a port clash or
# a VRAM allocation error.
Conflicts=glm-flash.service nemotron-nano.service gemma4-26b.service llama-swap.service

[Container]
Image=docker.io/vllm/vllm-openai:v0.29.0
ContainerName=qwen3-coder

PublishPort=127.0.0.1:8000:8000

Volume=%h/.cache/huggingface:/root/.cache/huggingface:z
Volume=%h/.cache/vllm:/root/.cache/vllm:z

AddDevice=nvidia.com/gpu=all
GroupAdd=keep-groups
PodmanArgs=--ipc=host

HealthCmd=python3 -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8000/health').status == 200 else 1)"
HealthInterval=30s
HealthTimeout=5s
HealthRetries=20
HealthStartPeriod=10m

# 30.5B total / 3.3B active, GQA with 32 Q heads and 4 KV heads, 262K native.
# Non-thinking only: it emits no reasoning blocks, so there is deliberately no
# --reasoning-parser and no chat template kwargs here. That is the point of this
# unit -- it isolates how much of your context growth was reasoning tokens.
#
# 98304 is an estimate, not measured. 4 KV heads across 48 layers is roughly
# 96KB/token, so ~9.7GB of cache on top of ~17GB of weights. If vLLM refuses to
# start, step down to 65536; if it starts with cache to spare, try 131072.
#
# Sampling is Qwen's published recommendation and differs from GLM's -- top_p
# 0.8, top_k 20, and a non-zero repetition_penalty that GLM explicitly wants off.
Exec=--model cpatonn/Qwen3-Coder-30B-A3B-Instruct-AWQ \
     --served-model-name qwen3-coder \
     --tensor-parallel-size 1 \
     --max-model-len 98304 \
     --gpu-memory-utilization 0.90 \
     --max-num-seqs 2 \
     --tool-call-parser qwen3_coder \
     --enable-auto-tool-choice \
     --override-generation-config '{"temperature":0.7,"top_p":0.8,"top_k":20,"repetition_penalty":1.05}'

[Service]
Restart=always
TimeoutStartSec=1800

# Manual-start only, same as glm-flash.container.
