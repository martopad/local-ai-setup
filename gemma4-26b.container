[Unit]
Description=vLLM serving Gemma 4 26B-A4B (sliding window, AWQ)
After=network-online.target
Wants=network-online.target
Conflicts=glm-flash.service qwen3-coder.service nemotron-nano.service llama-swap.service

[Container]
Image=docker.io/vllm/vllm-openai:v0.29.0
ContainerName=gemma4-26b

PublishPort=127.0.0.1:8000:8000

Volume=%h/.cache/huggingface:/root/.cache/huggingface:z
Volume=%h/.cache/vllm:/root/.cache/vllm:z

AddDevice=nvidia.com/gpu=all
GroupAdd=keep-groups
PodmanArgs=--ipc=host

HealthCmd=python3 -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8000/health').status == 200 else 1)"
HealthInterval=30s
HealthTimeout=5s
HealthRetries=20
HealthStartPeriod=10m

# 25.2B total / 3.8B active, 30 layers, 128 experts with 8 active plus 1 shared,
# 1024-token sliding window, 256K native, multimodal (text + image). At ~14GB the
# weights are the smallest of the four models here, which leaves the most room
# for cache.
#
# INCOMPLETE: tool calling is not configured. Gemma 4 supports function calling,
# but I could not confirm which vLLM tool-call parser handles its format, and an
# invalid value fails at startup rather than degrading. Until this is resolved
# opencode's tool calls will not be parsed, so this unit is not yet usable for
# agentic work -- only for plain chat. Find the right value with:
#   podman run --rm docker.io/vllm/vllm-openai:v0.29.0 \
#     vllm serve --help=all | grep -A20 'tool-call-parser'
# then add:
#   --enable-auto-tool-choice \
#   --tool-call-parser <value> \
#
# Thinking exists in the open weights but is off by default and is enabled
# through chat template kwargs. The key name is unverified -- check the
# checkpoint's chat template before trusting it:
#   --default-chat-template-kwargs '{"enable_thinking":true}' \
#
# --dtype float16 and --quantization awq_marlin are both required by the AWQ
# checkpoints. An AWQ MoE weight-loading bug (KeyError on packed expert names)
# affected older vLLM but predates v0.29.0.
#
# Sampling is left at the checkpoint's defaults; Google's recommended values for
# this model are not carried over from GLM.
#
# Alternatives if this checkpoint misbehaves:
#   cyankiwi/gemma-4-26B-A4B-it-qat-AWQ-INT4   QAT, best quality retention
#   dhruvil237/gemma-4-26B-A4B-it-W4A16        GPTQ compressed-tensors, group 64
#     (group 64 is deliberate: some MoE down_proj widths are 704 and 2112, which
#      are not divisible by 128, so a default G128 export is invalid)
#
# There is an official MTP draft head (gemma-4-26B-A4B-it-assistant) for
# speculative decoding. Not enabled: it costs KV cache headroom, and at least one
# report measured it slower than no speculation on this model.
Exec=--model cyankiwi/gemma-4-26B-A4B-it-AWQ-4bit \
     --served-model-name gemma-4-26b-a4b \
     # --quantization awq_marlin \
     --quantization compressed-tensors \
     --dtype float16 \
     --tensor-parallel-size 1 \
     --max-model-len 98304 \
     --gpu-memory-utilization 0.90 \
     --max-num-seqs 2 \
     --reasoning-parser gemma4 \
     --enable-auto-tool-choice \
     --tool-call-parser gemma4 \
     --default-chat-template-kwargs '{"enable_thinking":true}'

[Service]
Restart=always
TimeoutStartSec=1800

# Manual-start only, same as glm-flash.container.
