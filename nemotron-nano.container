[Unit]
Description=vLLM serving Nemotron 3 Nano 30B-A3B (Mamba hybrid, NVFP4)
After=network-online.target
Wants=network-online.target
Conflicts=glm-flash.service qwen3-coder.service gemma4-26b.service llama-swap.service

[Container]
Image=docker.io/vllm/vllm-openai:v0.29.0
ContainerName=nemotron-nano

PublishPort=127.0.0.1:8000:8000

Volume=%h/.cache/huggingface:/root/.cache/huggingface:z
Volume=%h/.cache/vllm:/root/.cache/vllm:z
# The nano_v3 reasoning parser ships as a loose .py file in the model repo, not
# inside vLLM, so it has to be mounted in. Populate the directory first:
#   mkdir -p ~/.cache/vllm-parsers && cd ~/.cache/vllm-parsers
#   wget https://huggingface.co/nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-BF16/resolve/main/nano_v3_reasoning_parser.py
# vLLM exits at startup if the file is missing.
Volume=%h/.cache/vllm-parsers:/parsers:z

AddDevice=nvidia.com/gpu=all
GroupAdd=keep-groups
PodmanArgs=--ipc=host

HealthCmd=python3 -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8000/health').status == 200 else 1)"
HealthInterval=30s
HealthTimeout=5s
HealthRetries=20
HealthStartPeriod=10m

# Hybrid Mamba-2/Transformer MoE: 23 Mamba-2 + MoE layers, only 6 attention
# layers, 31.6B total / ~3.2B active, 1M native context. The Mamba layers hold
# fixed-size recurrent state that does not grow with sequence length, so KV cache
# pressure comes from 6 layers rather than all of them. That is the reason to try
# this model at all given the context ceiling is the actual constraint here.
#
# NVFP4 is the only variant that fits 32GB: BF16 is ~60GB and FP8 ~30GB leaves
# nothing for cache. It is Blackwell-native and published by NVIDIA directly, not
# a community requant. vLLM detects it as modelopt_fp4, so no --quantization.
#
# --trust-remote-code is required; the architecture needs code from the repo.
# --mamba-ssm-cache-dtype float32 is NVIDIA's accuracy recommendation; float16
# is faster with a small accuracy cost if you want to trade.
# --async-scheduling cuts host overhead between decode steps.
#
# Use --reasoning-parser nano_v3, not a DeepSeek parser. There is a known
# tool-calling bug when the wrong parser is paired with this model.
#
# Reasoning is toggled per-request rather than by a server flag, so there is no
# --default-chat-template-kwargs here. Send {"enable_thinking": false} in
# chat_template_kwargs to turn it off. The model also honours a thinking-token
# budget, which is a finer-grained version of GLM's clear_thinking switch.
#
# 131072 is a conservative start given how little of this model accumulates KV.
# Raise it if the reported cache utilisation stays low.
Exec=--model nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-NVFP4 \
     --served-model-name nemotron-nano-3 \
     --trust-remote-code \
     --tensor-parallel-size 1 \
     --max-model-len 131072 \
     --gpu-memory-utilization 0.90 \
     --max-num-seqs 2 \
     --tool-call-parser qwen3_coder \
     --enable-auto-tool-choice \
     --reasoning-parser-plugin /parsers/nano_v3_reasoning_parser.py \
     --reasoning-parser nano_v3 \
     --mamba-ssm-cache-dtype float32 \
     --async-scheduling

[Service]
Restart=always
TimeoutStartSec=1800

# Manual-start only, same as glm-flash.container.
